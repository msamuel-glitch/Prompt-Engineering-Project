# Copy this file to backend/.env and fill it in. Never commit backend/.env.

# Anthropic API key, created in the Anthropic Console with a spending limit.
ANTHROPIC_API_KEY=

# "claude" (default) calls the Claude API. "fake" builds a placeholder sheet
# from the course text without any AI call: no key and no cost, for UI work.
# "fixture" serves a sheet recorded earlier for the one course it was recorded
# from, and falls back to "fake" for any other course: real content for a
# demonstration without a key, and a placeholder rather than a sheet about
# something else.
STUDY_SHEET_GENERATOR=claude

# Model used by the "claude" generator.
CLAUDE_MODEL=claude-opus-5-5

# Version of prompts/study-sheet/ used by the application. It must ask for the
# structured output defined in backend/app/schemas.py (v2 or later).
STUDY_SHEET_PROMPT_VERSION=v2

# Where saved sheets are kept. The default is backend/data/sheets.db, which Git
# ignores. Delete the file to start from an empty library.
# STUDY_SHEET_DB=

# Recorded sheet used by the "fixture" generator. The default is the v2 output
# on the synthetic course, in outputs/study-sheet/v2/.
# STUDY_SHEET_FIXTURE=
